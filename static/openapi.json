{
  "openapi": "3.0.0",
  "info": {
    "title": "Vulnerable Bank API",
    "description": "의도적으로 취약하게 만든 뱅킹 애플리케이션의 API 문서",
    "version": "1.0.0",
    "contact": {
      "name": "Vulnerable Bank Support",
      "url": "https://github.com/Commando-X/vuln-bank"
    }
  },
  "servers": [
    {
      "url": "https://vulnbank.org",
      "description": "통제된 운영 서버"
    }
  ],
  "tags": [
    {
      "name": "authentication",
      "description": "인증 관련 엔드포인트"
    },
    {
      "name": "transactions",
      "description": "거래 관리 엔드포인트"
    },
    {
      "name": "users",
      "description": "사용자 관리 엔드포인트"
    },
    {
      "name": "admin",
      "description": "관리자용 엔드포인트"
    },
    {
      "name": "virtual-cards",
      "description": "가상 카드 관리 엔드포인트"
    },
    {
      "name": "bill-payments",
      "description": "공과금 납부 작업"
    },
    {
      "name": "merchants",
      "description": "공개 결제 연동을 위한 가맹점 등록 및 인증"
    },
    {
      "name": "merchant-payments",
      "description": "가맹점 카드 결제 엔드포인트"
    },
    {
      "name": "ai-agent",
      "description": "AI 고객 지원 에이전트 (의도적으로 취약함)"
    },
    {
      "name": "internal",
      "description": "SSRF 시연용 내부 전용 엔드포인트"
    }
  ],
  "paths": {
    "/register": {
      "post": {
        "tags": ["authentication"],
        "summary": "Register a new user",
        "description": "새 사용자 계정을 생성합니다. BOPLA에 취약합니다.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string",
                    "example": "testuser"
                  },
                  "password": {
                    "type": "string",
                    "example": "password123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "가입 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "message": {
                      "type": "string"
                    },
                    "debug_data": {
                      "type": "object",
                      "description": "민감 데이터 노출 (취약점)"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/login": {
      "post": {
        "tags": ["authentication"],
        "summary": "Log in to the application",
        "description": "사용자를 인증하고 JWT 토큰을 발급받습니다. SQL 인젝션에 취약합니다.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string",
                    "example": "testuser"
                  },
                  "password": {
                    "type": "string",
                    "example": "password123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "로그인 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "token": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v{version}/forgot-password": {
      "post": {
        "tags": ["authentication"],
        "summary": "Request password reset (versioned)",
        "description": "재설정 PIN을 생성합니다. v1/v2는 3자리 PIN을 발급하며(v1은 PIN을 노출하고 v2는 숨김), v3는 PIN을 노출하지 않고 4자리 PIN을 발급합니다.",
        "parameters": [
          {
            "name": "version",
            "in": "path",
            "required": true,
            "description": "API 버전 (1: 구 엔드포인트, 2: 노출 축소, 3: 4자리 PIN 기본값)",
            "schema": {
              "type": "integer",
              "enum": [1, 2, 3],
              "default": 3
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "재설정 PIN 생성됨",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "debug_info": {
                      "type": "object",
                      "description": "v1: PIN을 포함한 다량의 민감 정보가 담겨 있습니다. v2: 민감 정보가 줄어들며 PIN은 노출되지 않습니다."
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "사용자를 찾을 수 없음"
          }
        }
      }
    },
    "/api/v{version}/reset-password": {
      "post": {
        "tags": ["authentication"],
        "summary": "Reset password using PIN (versioned)",
        "description": "PIN으로 비밀번호를 재설정합니다. v1/v2는 3자리 PIN을, v3는 기본적으로 4자리 PIN을 요구합니다.",
        "parameters": [
          {
            "name": "version",
            "in": "path",
            "required": true,
            "description": "API 버전 (1: 전체 데이터 노출, 2: 데이터 노출 축소, 3: 4자리 PIN 기본값)",
            "schema": {
              "type": "integer",
              "enum": [1, 2, 3],
              "default": 3
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "reset_pin": {
                    "type": "string",
                    "pattern": "^\\d{3,4}$",
                    "description": "v1/v2는 3자리, v3는 4자리 (기본값)"
                  },
                  "new_password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "비밀번호 재설정 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "debug_info": {
                      "type": "object",
                      "description": "v1: 사용된 PIN을 포함한 다량의 디버그 정보가 담겨 있습니다. v2: 포함되지 않습니다."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "잘못된 재설정 PIN"
          }
        }
      }
    },
    "/transactions/{account_number}": {
      "get": {
        "tags": ["transactions"],
        "summary": "Get transaction history",
        "description": "임의 계좌의 거래 내역을 조회합니다. BOLA에 취약합니다.",
        "parameters": [
          {
            "name": "account_number",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "거래 목록 조회됨",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "transactions": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer"
                          },
                          "from_account": {
                            "type": "string"
                          },
                          "to_account": {
                            "type": "string"
                          },
                          "amount": {
                            "type": "number"
                          },
                          "timestamp": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/transfer": {
      "post": {
        "tags": ["transactions"],
        "summary": "Transfer money",
        "description": "계좌 간 송금을 수행합니다. 경쟁 상태(Race Condition)에 취약합니다.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "to_account": {
                    "type": "string"
                  },
                  "amount": {
                    "type": "number"
                  },
                  "description": {
                    "type": "string",
                    "required": false
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "송금 성공"
          }
        }
      }
    },
    "/upload_profile_picture": {
      "post": {
        "tags": ["users"],
        "summary": "Upload profile picture",
        "description": "사용자 프로필 사진을 업로드합니다. 여러 파일 업로드 취약점이 있습니다.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "profile_picture": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "업로드 성공"
          }
        }
      }
    },
    "/upload_profile_picture_url": {
      "post": {
        "tags": ["users"],
        "summary": "Upload profile picture by URL (Intentionally Vulnerable)",
        "description": "사용자가 제공한 URL에서 이미지를 가져와 프로필 사진으로 저장합니다. SSRF 및 안전하지 않은 다운로드 동작에 취약합니다 (허용 목록 없음, 리다이렉트 추적, SSL 검증 비활성화, content-type/크기 검증 없음).",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "image_url": {
                    "type": "string",
                    "example": "http://127.0.0.1:8080/image.png"
                  }
                },
                "required": ["image_url"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "이미지를 가져와 저장함"
          },
          "400": {
            "description": "잘못되었거나 접근할 수 없는 URL"
          }
        }
      }
    },
    "/internal/secret": {
      "get": {
        "tags": ["internal"],
        "summary": "Internal secrets (SSRF demo)",
        "description": "민감한 애플리케이션 비밀 값과 환경 정보 미리보기를 반환합니다. 루프백에서만 접근 가능하도록 의도되었으므로, URL 가져오기 엔드포인트를 이용한 SSRF로 조회하세요.",
        "responses": {
          "200": {"description": "비밀 값 반환됨"},
          "403": {"description": "접근 금지 (루프백이 아님)"}
        }
      }
    },
    "/internal/config.json": {
      "get": {
        "tags": ["internal"],
        "summary": "Internal config (SSRF demo)",
        "description": "앱 설정 JSON을 반환합니다. SSRF 시연용입니다.",
        "responses": {
          "200": {"description": "설정 반환됨"},
          "403": {"description": "접근 금지 (루프백이 아님)"}
        }
      }
    },
    "/latest/meta-data/": {
      "get": {
        "tags": ["internal"],
        "summary": "Cloud metadata root (mock)",
        "description": "클라우드 인스턴스 메타데이터 서비스의 루트 디렉터리를 흉내 냅니다.",
        "responses": {
          "200": {"description": "디렉터리 목록 반환됨"},
          "403": {"description": "접근 금지 (루프백이 아님)"}
        }
      }
    },
    "/latest/meta-data/iam/security-credentials/": {
      "get": {
        "tags": ["internal"],
        "summary": "Metadata IAM roles (mock)",
        "responses": {
          "200": {"description": "역할 목록 반환됨"},
          "403": {"description": "접근 금지 (루프백이 아님)"}
        }
      }
    },
    "/latest/meta-data/iam/security-credentials/vulnbank-role": {
      "get": {
        "tags": ["internal"],
        "summary": "Metadata IAM role credentials (mock)",
        "responses": {
          "200": {"description": "자격 증명 문서 반환됨"},
          "403": {"description": "접근 금지 (루프백이 아님)"}
        }
      }
    },
    "/sup3r_s3cr3t_admin": {
      "get": {
        "tags": ["admin"],
        "summary": "Admin panel",
        "description": "숨겨진 관리자 패널입니다. 은닉에 의존한 보안입니다.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "관리자 패널 HTML"
          }
        }
      }
    },
    "/admin/create_admin": {
      "post": {
        "tags": ["admin"],
        "summary": "Create new admin user",
        "description": "새 관리자 계정을 생성합니다. 관리자 권한이 필요합니다.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string",
                    "example": "newadmin"
                  },
                  "password": {
                    "type": "string",
                    "example": "adminpass123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "관리자 사용자 생성 성공"
          },
          "403": {
            "description": "접근 거부 - 관리자 권한 필요"
          }
        }
      }
    },
    "/admin/delete_account/{user_id}": {
      "post": {
        "tags": ["admin"],
        "summary": "Delete user account",
        "description": "사용자 계정을 삭제합니다. 관리자 권한이 필요합니다.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "삭제할 사용자의 ID"
          }
        ],
        "responses": {
          "200": {
            "description": "계정 삭제 성공"
          },
          "403": {
            "description": "접근 거부 - 관리자 권한 필요"
          }
        }
      }
    },
    "/check_balance/{account_number}": {
      "get": {
        "tags": ["transactions"],
        "summary": "Check account balance",
        "description": "임의 계좌의 잔액을 확인합니다. BOLA에 취약합니다.",
        "parameters": [
          {
            "name": "account_number",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "잔액 조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "username": {
                      "type": "string"
                    },
                    "balance": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "계좌를 찾을 수 없음"
          }
        }
      }
    },
    "/api/transactions": {
      "get": {
        "tags": ["transactions"],
        "summary": "Get transactions API",
        "description": "특정 계좌의 거래 내역을 가져옵니다. SQL 인젝션에 취약합니다.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "account_number",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "거래 내역 조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "transactions": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "account_number": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "계좌 번호 필요"
          }
        }
      }
    },
    "/request_loan": {
      "post": {
        "tags": ["transactions"],
        "summary": "Request a loan",
        "description": "처리할 대출 신청을 제출합니다.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "amount": {
                    "type": "number",
                    "description": "신청한 대출 금액"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "대출 신청 제출 성공"
          },
          "401": {
            "description": "인증 필요"
          }
        }
      }
    },
    "/admin/approve_loan/{loan_id}": {
      "post": {
        "tags": ["admin"],
        "summary": "Approve loan",
        "description": "사용자의 대출 신청을 승인합니다.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "loan_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "대출 승인됨"
          }
        }
      }
    },
    "/api/virtual-cards/create": {
      "post": {
        "tags": ["virtual-cards"],
        "summary": "Create a new virtual card",
        "description": "지정한 한도와 유형으로 새 가상 카드를 생성합니다. 여러 보안 문제에 취약합니다.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "card_limit": {
                    "type": "number",
                    "example": 1000
                  },
                  "card_type": {
                    "type": "string",
                    "enum": ["standard", "premium"],
                    "example": "standard"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "카드 생성 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "card_details": {
                      "type": "object",
                      "description": "민감한 카드 정보 노출"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/virtual-cards": {
      "get": {
        "tags": ["virtual-cards"],
        "summary": "Get user's virtual cards",
        "description": "인증된 사용자의 모든 가상 카드를 조회합니다. 정보 노출에 취약합니다.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
