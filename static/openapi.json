          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "example": "What is my account balance?",
                    "description": "AI 에이전트에 보낼 메시지입니다. 프롬프트 인젝션 공격에 취약합니다."
                  }
                },
                "required": ["message"]
              }
            }
          }
        },
        "responses": {
